+void AAesirCharacter::Dash()
+{
+	const float Now = GetWorld()->GetTimeSeconds();
+	if (!IsAlive() || Now - LastDashTime < DashCooldown)
+	{
+		return;
+	}
+	LastDashTime = Now;
+	FVector Dir = GetLastMovementInputVector();
+	if (Dir.IsNearlyZero())
+	{
+		Dir = GetActorForwardVector();
+	}
+	Dir.Z = 0.f;
+	LaunchCharacter(Dir.GetSafeNormal() * DashImpulse, true, false);
+	UAesirAgentSubsystem::Record(this, TEXT("dash"), this, nullptr, true, nullptr);
 }
 
