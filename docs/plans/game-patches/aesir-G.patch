new file mode 100644
index 0000000..5b69a9a
--- /dev/null
+++ b/Source/AesirWaveDefense/AesirTuning.cpp
@@ -0,0 +1,27 @@
+#include "AesirTuning.h"
+
+#include "AesirWaveDefenseGameMode.h"
+#include "Curves/CurveFloat.h"
+#include "Engine/World.h"
+
+const FAesirWaveRow* UAesirTuning::FindWave(int32 WaveNumber) const
+{
+	if (!Waves || !Waves->GetRowStruct() || !Waves->GetRowStruct()->IsChildOf(FAesirWaveRow::StaticStruct()))
+	{
+		return nullptr; // no table, or a table of another row type: the built-in formula
+	}
+	// Past the table (or a deleted row) the game mode uses its built-in formula.
+	return Waves->FindRow<FAesirWaveRow>(FName(*FString::Printf(TEXT("Wave_%02d"), WaveNumber)), TEXT("AesirTuning"), false);
+}
+
+float UAesirTuning::FalloffAt(float Distance) const
+{
+	return DamageFalloff ? DamageFalloff->GetFloatValue(Distance) : 1.f;
+}
+
+const UAesirTuning* UAesirTuning::Get(const UObject* WorldContext)
+{
+	const UWorld* World = WorldContext ? WorldContext->GetWorld() : nullptr;
+	const AAesirWaveDefenseGameMode* GM = World ? World->GetAuthGameMode<AAesirWaveDefenseGameMode>() : nullptr;
+	return GM ? GM->GetTuning() : nullptr;
+}
