+#pragma once
+
+#include "CoreMinimal.h"
+#include "Subsystems/GameInstanceSubsystem.h"
+#include "AesirAgentSubsystem.generated.h"
+
+class FJsonObject;
+
+/**
+ * The game's agent interface (unreal-mcp game_api, docs/plans/GAME_CONTRACT.md in the
+ * server repo): capabilities, a side-effect-free snapshot, an event journal and
+ * idempotent commands, all as JSON strings. One per game instance — a new world_epoch
+ * every PIE session. Game code reports events with Record().
+ */
+UCLASS()
+class AESIRWAVEDEFENSE_API UAesirAgentSubsystem : public UGameInstanceSubsystem
+{
+	GENERATED_BODY()
+
+public:
+	virtual void Initialize(FSubsystemCollectionBase& Collection) override;
+	virtual void Deinitialize() override;
+
+	/** {api_version, world_epoch, commands: [{name, tier, args}], event_kinds}. */
+	UFUNCTION(BlueprintPure, Category = "Aesir|Agent")
+	FString GetCapabilitiesJson() const;
+
+	/** The game state, read-only: wave, enemies, player, score, difficulty, world_epoch, events_cursor. */
+	UFUNCTION(BlueprintPure, Category = "Aesir|Agent")
+	FString PeekSnapshotJson() const;
+
+	/** Events after Cursor ("" = from the start; "<epoch>:<seq>" as returned in next_cursor):
+	 *  {events, next_cursor, gap, dropped, world_epoch, reason?}. A cursor from another
+	 *  world is a gap (reason world_changed); one older than the journal reports dropped. */
+	UFUNCTION(BlueprintPure, Category = "Aesir|Agent")
+	FString GetEventsSince(const FString& Cursor) const;
+
+	/** Run {"command", "request_id", "world_epoch", ...args} once: a repeated request_id
+	 *  returns the recorded response; another world's epoch is dedup_expired, not run. */
+	UFUNCTION(BlueprintCallable, Category = "Aesir|Agent")
+	FString ExecuteCommandJson(const FString& RequestJson);
+
+	/** Report a gameplay event (server side). Data may be null. */
+	static void Record(const UObject* WorldContext, const FString& Kind, const AActor* Actor = nullptr,
+		const AActor* Target = nullptr, bool bByPlayer = false, TSharedPtr<FJsonObject> Data = nullptr);
+
+	static UAesirAgentSubsystem* Get(const UObject* WorldContext);
+
+	/** The hit marker is on screen: stamp data.visual_t (world seconds) on the recent
+	 *  hits that have none — the hit-to-visual latency the feel audit reads. */
+	static void MarkHitVisual(const UObject* WorldContext);
+
+	/** Dev-only: record Count "debug" events (exercises the journal's overrun reporting). */
+	UFUNCTION(BlueprintCallable, Category = "Debug")
+	void DebugRecordBurst(int32 Count);
+
+	/** Enemy health multiplier from set_difficulty (1 = normal). */
+	float GetDifficultyHealthScale() const { return DifficultyHealthScale; }
+
+private:
+	struct FEvent
+	{
+		int64 Seq = 0;
+		double T = 0.0;
+		FString Kind, Actor, Target;
+		bool bByPlayer = false;
+		TSharedPtr<FJsonObject> Data;
+	};
+
+	FString Result(const FString& RequestId, bool bAccepted, const FString& ErrorCode, const FString& Message,
+		TSharedPtr<FJsonObject> ResultObj) const;
+
+	/** A new world (map travel, a new PIE session): a new epoch, an empty journal and
+	 *  dedup memory, normal difficulty — the contract's "this world only". */
+	void ResetForWorld(UWorld* World, const UWorld::InitializationValues IVS);
+
+	FDelegateHandle WorldInitHandle;
+	static constexpr int32 MaxEvents = 1024;
+	static constexpr int32 MaxRemembered = 256;
+
+	FString WorldEpoch;
+	TArray<FEvent> Events; // ring: the newest MaxEvents
+	int64 NextSeq = 1;
+	TMap<FString, FString> Responses; // request_id -> response
+	TArray<FString> ResponseOrder;
+	float DifficultyHealthScale = 1.f;
+	FString Difficulty = TEXT("normal");
+};
