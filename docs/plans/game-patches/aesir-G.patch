+/** One wave of the wave table (/Game/Data/DT_Waves, rows Wave_01..). */
+USTRUCT(BlueprintType)
+struct FAesirWaveRow : public FTableRowBase
+{
+	GENERATED_BODY()
+
+	/** Enemies the wave spawns (a boss wave adds its boss on top). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Wave")
+	int32 EnemyCount = 5;
+
+	/** Seconds between spawns. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Wave")
+	float SpawnInterval = 0.8f;
+
+	/** Chance a spawn is a brute (from the game mode's first brute wave on). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Wave")
+	float BruteChance = 0.2f;
+
+	/** Chance a spawn is a sprinter (from wave 2 on). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Wave")
+	float SprinterChance = 0.25f;
+};
+
+/**
+ * The game's tuning, in data the agent can read and edit (/Game/Data/DA_AesirTuning).
+ * Read by the wave game mode at BeginPlay; when the asset is absent the game uses its
+ * built-in defaults.
+ */
+UCLASS(BlueprintType)
+class AESIRWAVEDEFENSE_API UAesirTuning : public UPrimaryDataAsset
+{
+	GENERATED_BODY()
+
+public:
+	/** Multiplies the damage of the player's weapons. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Combat")
+	float PlayerDamageMultiplier = 1.f;
+
+	/** Multiplies every enemy's health at spawn. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Combat")
+	float EnemyHealthMultiplier = 1.f;
+
+	/** Player weapon damage multiplier by hit distance (units). None = no falloff. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Combat")
+	TObjectPtr<UCurveFloat> DamageFalloff;
+
+	/** The wave table (FAesirWaveRow rows Wave_01..); a wave with no row uses the built-in formula. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Waves")
+	TObjectPtr<UDataTable> Waves;
+
+	/** The wave row for a wave number (1-based), or nullptr (no table, wrong row type, no such row). */
+	const FAesirWaveRow* FindWave(int32 WaveNumber) const;
+
+	/** Damage multiplier at a distance (1 without a curve). */
+	float FalloffAt(float Distance) const;
+
+	/** The tuning the running game uses (the wave game mode's), or nullptr. */
+	static const UAesirTuning* Get(const UObject* WorldContext);
+};
