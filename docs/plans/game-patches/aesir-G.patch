+#include "AesirAgentSubsystem.h"
+
+#include "AesirCharacter.h"
+#include "AesirGameState.h"
+#include "AesirPlayerState.h"
+#include "AesirWaveDefenseGameMode.h"
+#include "AesirWeapon.h"
+#include "Dom/JsonObject.h"
+#include "EnemyCharacter.h"
+#include "Engine/GameInstance.h"
+#include "Engine/World.h"
+#include "EngineUtils.h"
+#include "GameFramework/PlayerController.h"
+#include "Kismet/GameplayStatics.h"
+#include "Serialization/JsonReader.h"
+#include "Serialization/JsonSerializer.h"
+#include "Serialization/JsonWriter.h"
+
+namespace
+{
+FString ToJson(const TSharedRef<FJsonObject>& Obj)
+{
+	FString Out;
+	TSharedRef<TJsonWriter<>> W = TJsonWriterFactory<>::Create(&Out);
+	FJsonSerializer::Serialize(Obj, W);
+	return Out;
+}
+
+FString WaveStateName(EWaveState S)
+{
+	switch (S)
+	{
+	case EWaveState::WaitingToStart: return TEXT("waiting");
+	case EWaveState::Intermission: return TEXT("intermission");
+	case EWaveState::InProgress: return TEXT("in_progress");
+	case EWaveState::Defeat: return TEXT("defeat");
+	case EWaveState::Victory: return TEXT("victory");
+	}
+	return TEXT("unknown");
+}
+} // namespace
+
+void UAesirAgentSubsystem::Initialize(FSubsystemCollectionBase& Collection)
+{
+	Super::Initialize(Collection);
+	WorldEpoch = FGuid::NewGuid().ToString(EGuidFormats::DigitsWithHyphensLower);
+	WorldInitHandle = FWorldDelegates::OnPostWorldInitialization.AddUObject(this, &UAesirAgentSubsystem::ResetForWorld);
+}
+
+void UAesirAgentSubsystem::Deinitialize()
+{
+	FWorldDelegates::OnPostWorldInitialization.Remove(WorldInitHandle);
+	Super::Deinitialize();
+}
+
+void UAesirAgentSubsystem::ResetForWorld(UWorld* World, const UWorld::InitializationValues IVS)
+{
+	if (!World || World->GetGameInstance() != GetGameInstance())
+	{
+		return; // another game instance's world (another PIE client, the editor)
+	}
+	WorldEpoch = FGuid::NewGuid().ToString(EGuidFormats::DigitsWithHyphensLower);
+	Events.Reset();
+	Responses.Reset();
+	ResponseOrder.Reset();
+	DifficultyHealthScale = 1.f;
+	Difficulty = TEXT("normal");
+}
+
+void UAesirAgentSubsystem::MarkHitVisual(const UObject* WorldContext)
+{
+	UAesirAgentSubsystem* Self = Get(WorldContext);
+	const UWorld* World = WorldContext ? WorldContext->GetWorld() : nullptr;
+	if (!Self || !World)
+	{
+		return;
+	}
+	const double Now = World->GetTimeSeconds();
+	for (int32 i = Self->Events.Num() - 1; i >= 0 && Now - Self->Events[i].T < 1.0; --i)
+	{
+		FEvent& E = Self->Events[i];
+		if (E.Kind == TEXT("hit") && E.Data.IsValid() && !E.Data->HasField(TEXT("visual_t")))
+		{
+			E.Data->SetNumberField(TEXT("visual_t"), Now);
+		}
+	}
+}
+
+UAesirAgentSubsystem* UAesirAgentSubsystem::Get(const UObject* WorldContext)
+{
+	const UWorld* World = WorldContext ? WorldContext->GetWorld() : nullptr;
+	UGameInstance* GI = World ? World->GetGameInstance() : nullptr;
+	return GI ? GI->GetSubsystem<UAesirAgentSubsystem>() : nullptr;
+}
+
+FString UAesirAgentSubsystem::GetCapabilitiesJson() const
+{
+	TSharedRef<FJsonObject> Root = MakeShared<FJsonObject>();
+	Root->SetStringField(TEXT("api_version"), TEXT("aesir.agent.v1"));
+	Root->SetStringField(TEXT("world_epoch"), WorldEpoch);
+	TArray<TSharedPtr<FJsonValue>> Commands;
+	auto AddCommand = [&Commands](const TCHAR* Name, const TCHAR* Tier, const TCHAR* Args)
+	{
+		TSharedRef<FJsonObject> C = MakeShared<FJsonObject>();
+		C->SetStringField(TEXT("name"), Name);
+		C->SetStringField(TEXT("tier"), Tier); // informational: the server gates game_command as exec
+		C->SetStringField(TEXT("args"), Args);
+		Commands.Add(MakeShared<FJsonValueObject>(C));
+	};
+	AddCommand(TEXT("start_wave"), TEXT("mutating"), TEXT("{} — from an intermission"));
+	AddCommand(TEXT("set_difficulty"), TEXT("mutating"), TEXT("{level: easy|normal|hard} — enemy health x0.75/x1/x1.5, this world only"));
+	Root->SetArrayField(TEXT("commands"), Commands);
+	TArray<TSharedPtr<FJsonValue>> Kinds;
+	for (const TCHAR* K : {TEXT("weapon_fire"), TEXT("hit"), TEXT("kill"), TEXT("death"), TEXT("dash"), TEXT("vfx"),
+		TEXT("sfx"), TEXT("camera_shake"), TEXT("wave_start"), TEXT("wave_end")})
+	{
+		Kinds.Add(MakeShared<FJsonValueString>(K));
+	}
+	Root->SetArrayField(TEXT("event_kinds"), Kinds);
+	return ToJson(Root);
+}
+
+FString UAesirAgentSubsystem::PeekSnapshotJson() const
+{
+	TSharedRef<FJsonObject> Root = MakeShared<FJsonObject>();
+	Root->SetStringField(TEXT("api_version"), TEXT("aesir.agent.v1"));
+	Root->SetStringField(TEXT("world_epoch"), WorldEpoch);
+	Root->SetStringField(TEXT("events_cursor"), FString::Printf(TEXT("%s:%lld"), *WorldEpoch, NextSeq - 1));
+	Root->SetStringField(TEXT("difficulty"), Difficulty);
+	const UWorld* World = GetWorld();
+	if (const AAesirGameState* GS = World ? World->GetGameState<AAesirGameState>() : nullptr)
+	{
+		Root->SetNumberField(TEXT("wave_number"), GS->WaveNumber);
+		Root->SetStringField(TEXT("wave_state"), WaveStateName(GS->WaveState));
+		Root->SetNumberField(TEXT("enemies_remaining"), GS->EnemiesRemaining);
+		Root->SetNumberField(TEXT("intermission_remaining_s"), GS->GetIntermissionTimeRemaining());
+		Root->SetStringField(TEXT("mission"), GS->MissionType);
+	}
+	int32 OnField = 0;
+	if (World)
+	{
+		for (TActorIterator<AEnemyCharacter> It(const_cast<UWorld*>(World)); It; ++It)
+		{
+			OnField += It->IsAlive() ? 1 : 0;
+		}
+	}
+	Root->SetNumberField(TEXT("enemies_on_field"), OnField);
+	const APlayerController* PC = World ? World->GetFirstPlayerController() : nullptr;
+	TSharedRef<FJsonObject> Player = MakeShared<FJsonObject>();
+	if (const AAesirCharacter* Ch = PC ? Cast<AAesirCharacter>(PC->GetPawn()) : nullptr)
+	{
+		Player->SetBoolField(TEXT("alive"), Ch->IsAlive());
+		Player->SetNumberField(TEXT("health"), Ch->GetHealth());
+		Player->SetNumberField(TEXT("max_health"), Ch->GetMaxHealth());
+		if (const AAesirWeapon* W = Ch->GetCurrentWeapon())
+		{
+			Player->SetStringField(TEXT("weapon"), W->GetDisplayName());
+			Player->SetNumberField(TEXT("ammo"), W->GetCurrentAmmo());
+			Player->SetNumberField(TEXT("max_ammo"), W->GetMagazineSize());
+		}
+		const FVector L = Ch->GetActorLocation();
+		Player->SetArrayField(TEXT("location"), {MakeShared<FJsonValueNumber>(L.X), MakeShared<FJsonValueNumber>(L.Y),
+			MakeShared<FJsonValueNumber>(L.Z)});
+	}
+	else
+	{
+		Player->SetBoolField(TEXT("alive"), false);
+	}
+	Root->SetObjectField(TEXT("player"), Player);
+	if (const AAesirPlayerState* PS = PC ? PC->GetPlayerState<AAesirPlayerState>() : nullptr)
+	{
+		Root->SetNumberField(TEXT("kills"), PS->GetKills());
+		Root->SetNumberField(TEXT("score"), PS->GetScore());
+	}
+	return ToJson(Root);
+}
+
+FString UAesirAgentSubsystem::GetEventsSince(const FString& Cursor) const
+{
+	TSharedRef<FJsonObject> Root = MakeShared<FJsonObject>();
+	Root->SetStringField(TEXT("world_epoch"), WorldEpoch);
+	int64 After = 0;
+	bool bGap = false;
+	int64 Dropped = 0;
+	FString Epoch, SeqStr;
+	if (!Cursor.IsEmpty())
+	{
+		if (!Cursor.Split(TEXT(":"), &Epoch, &SeqStr) || !SeqStr.IsNumeric())
+		{
+			bGap = true; // not a cursor this API made: replay from the start, flagged
+			Root->SetStringField(TEXT("reason"), TEXT("bad_cursor"));
+		}
+		else if (Epoch != WorldEpoch)
+		{
+			// A cursor from another world (an earlier PIE session): everything since this
+			// world began, flagged as a gap.
+			bGap = true;
+			Root->SetStringField(TEXT("reason"), TEXT("world_changed"));
+		}
+		else
+		{
+			After = FCString::Atoi64(*SeqStr);
+		}
+	}
+	const int64 Oldest = Events.Num() > 0 ? Events[0].Seq : NextSeq;
+	if (After + 1 < Oldest)
+	{
+		// Events this world recorded but no longer keeps (also counted when the cursor was
+		// another world's: those are lost too).
+		Dropped = Oldest - (After + 1);
+		if (!bGap)
+		{
+			bGap = true;
+			Root->SetStringField(TEXT("reason"), TEXT("journal_overrun"));
+		}
+	}
+	TArray<TSharedPtr<FJsonValue>> Out;
+	int64 Last = After;
+	for (const FEvent& E : Events)
+	{
+		if (E.Seq <= After)
+		{
+			continue;
+		}
+		if (Out.Num() >= 500)
+		{
+			break; // the rest come with the next cursor
+		}
+		TSharedRef<FJsonObject> J = MakeShared<FJsonObject>();
+		J->SetNumberField(TEXT("seq"), (double)E.Seq);
+		J->SetNumberField(TEXT("t"), E.T);
+		J->SetStringField(TEXT("kind"), E.Kind);
+		if (!E.Actor.IsEmpty())
+		{
+			J->SetStringField(TEXT("actor"), E.Actor);
+		}
+		if (!E.Target.IsEmpty())
+		{
+			J->SetStringField(TEXT("target"), E.Target);
+		}
+		J->SetBoolField(TEXT("by_player"), E.bByPlayer);
+		if (E.Data.IsValid())
+		{
+			J->SetObjectField(TEXT("data"), E.Data);
+		}
+		Out.Add(MakeShared<FJsonValueObject>(J));
+		Last = E.Seq;
+	}
+	Root->SetArrayField(TEXT("events"), Out);
+	Root->SetBoolField(TEXT("gap"), bGap);
+	Root->SetNumberField(TEXT("dropped"), (double)Dropped);
+	Root->SetStringField(TEXT("next_cursor"), FString::Printf(TEXT("%s:%lld"), *WorldEpoch, Last));
+	return ToJson(Root);
+}
+
+void UAesirAgentSubsystem::Record(const UObject* WorldContext, const FString& Kind, const AActor* Actor,
+	const AActor* Target, bool bByPlayer, TSharedPtr<FJsonObject> Data)
+{
+	UAesirAgentSubsystem* Self = Get(WorldContext);
+	const UWorld* World = WorldContext ? WorldContext->GetWorld() : nullptr;
+	if (!Self || !World || World->GetNetMode() == NM_Client)
+	{
+		return; // the journal is the authority's (standalone / listen server / PIE)
+	}
+	FEvent E;
+	E.Seq = Self->NextSeq++;
+	E.T = World->GetTimeSeconds();
+	E.Kind = Kind;
+	E.Actor = Actor ? Actor->GetName() : FString();
+	E.Target = Target ? Target->GetName() : FString();
+	E.bByPlayer = bByPlayer;
+	E.Data = Data;
+	if (Self->Events.Num() >= MaxEvents)
+	{
+		Self->Events.RemoveAt(0, Self->Events.Num() - MaxEvents + 1, EAllowShrinking::No);
+	}
+	Self->Events.Add(MoveTemp(E));
+}
+
+FString UAesirAgentSubsystem::Result(const FString& RequestId, bool bAccepted, const FString& ErrorCode,
+	const FString& Message, TSharedPtr<FJsonObject> ResultObj) const
+{
+	TSharedRef<FJsonObject> Root = MakeShared<FJsonObject>();
+	Root->SetBoolField(TEXT("accepted"), bAccepted);
+	Root->SetStringField(TEXT("request_id"), RequestId);
+	Root->SetStringField(TEXT("world_epoch"), WorldEpoch);
+	if (!ErrorCode.IsEmpty())
+	{
+		Root->SetStringField(TEXT("error_code"), ErrorCode);
+		Root->SetStringField(TEXT("message"), Message);
+	}
+	if (ResultObj.IsValid())
+	{
+		Root->SetObjectField(TEXT("result"), ResultObj);
+	}
+	return ToJson(Root);
+}
+
+FString UAesirAgentSubsystem::ExecuteCommandJson(const FString& RequestJson)
+{
+	TSharedPtr<FJsonObject> Req;
+	if (!FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(RequestJson), Req) || !Req.IsValid())
+	{
+		return Result(FString(), false, TEXT("invalid_argument"), TEXT("the request is not a JSON object"), nullptr);
+	}
+	const FString RequestId = Req->GetStringField(TEXT("request_id"));
+	if (RequestId.IsEmpty())
+	{
+		return Result(RequestId, false, TEXT("invalid_argument"), TEXT("request_id is required"), nullptr);
+	}
+	FString Epoch;
+	if (!Req->TryGetStringField(TEXT("world_epoch"), Epoch) || Epoch != WorldEpoch)
+	{
+		// A request for another world (or none named): this world cannot know whether it
+		// already ran, so it does not run it.
+		return Result(RequestId, false, TEXT("dedup_expired"),
+			TEXT("world_epoch does not match this world (the game restarted?): read the game again"), nullptr);
+	}
+	if (const FString* Done = Responses.Find(RequestId))
+	{
+		return *Done; // a repeat: the recorded response, nothing runs again
+	}
+
+	const FString Command = Req->GetStringField(TEXT("command"));
+	FString Response;
+	AAesirWaveDefenseGameMode* GM = GetWorld() ? GetWorld()->GetAuthGameMode<AAesirWaveDefenseGameMode>() : nullptr;
+	if (Command == TEXT("start_wave"))
+	{
+		if (!GM)
+		{
+			Response = Result(RequestId, false, TEXT("precondition_failed"), TEXT("no wave game mode in this world"), nullptr);
+		}
+		else if (const AAesirGameState* RunGS = GetWorld()->GetGameState<AAesirGameState>();
+			RunGS && (RunGS->WaveState == EWaveState::Defeat || RunGS->WaveState == EWaveState::Victory))
+		{
+			Response = Result(RequestId, false, TEXT("run_over"), TEXT("the run has ended (defeat or victory)"), nullptr);
+		}
+		else if (!GM->StartWaveNow())
+		{
+			Response = Result(RequestId, false, TEXT("wave_in_progress"), TEXT("a wave is already running (or this mission has no waves)"), nullptr);
+		}
+		else
+		{
+			TSharedRef<FJsonObject> R = MakeShared<FJsonObject>();
+			const AAesirGameState* GS = GetWorld()->GetGameState<AAesirGameState>();
+			R->SetNumberField(TEXT("wave_number"), GS ? GS->WaveNumber : 0);
+			Response = Result(RequestId, true, FString(), FString(), R);
+		}
+	}
+	else if (Command == TEXT("set_difficulty"))
+	{
+		const FString Level = Req->GetStringField(TEXT("level"));
+		const float Scale = Level == TEXT("easy") ? 0.75f : Level == TEXT("normal") ? 1.f : Level == TEXT("hard") ? 1.5f : -1.f;
+		if (Scale < 0.f)
+		{
+			Response = Result(RequestId, false, TEXT("invalid_argument"), TEXT("level must be easy, normal or hard"), nullptr);
+		}
+		else
+		{
+			DifficultyHealthScale = Scale;
+			Difficulty = Level;
+			TSharedRef<FJsonObject> R = MakeShared<FJsonObject>();
+			R->SetStringField(TEXT("difficulty"), Level);
+			Response = Result(RequestId, true, FString(), FString(), R);
+		}
+	}
+	else
+	{
+		Response = Result(RequestId, false, TEXT("unknown_command"), FString::Printf(TEXT("no command %s"), *Command), nullptr);
+	}
+	Responses.Add(RequestId, Response);
+	ResponseOrder.Add(RequestId);
+	if (ResponseOrder.Num() > MaxRemembered)
+	{
+		Responses.Remove(ResponseOrder[0]);
+		ResponseOrder.RemoveAt(0);
+	}
+	return Response;
+}
+
+void UAesirAgentSubsystem::DebugRecordBurst(int32 Count)
+{
+	for (int32 i = 0; i < Count; ++i)
+	{
+		Record(this, TEXT("debug"));
+	}
+}
