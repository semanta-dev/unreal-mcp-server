+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPolyAgentApiUnrealMcpContract,
+	"PolyWorld.AgentApi.CommandCore.UnrealMcpContract",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+// unreal-mcp's game_api contract (its docs/plans/GAME_CONTRACT.md): world_epoch, a peek with
+// no side effects, epoch cursors, and commands refused for another world.
+bool FPolyAgentApiUnrealMcpContract::RunTest(const FString&)
+{
+	FHeadlessWorldFixture Fix;
+	if (!Fix.Ok()) { return false; }
+	UPolyWorldAgentSubsystem* Api = Fix.World->GetSubsystem<UPolyWorldAgentSubsystem>();
+	if (!TestNotNull(TEXT("agent subsystem"), Api)) { return false; }
+
+	const TSharedPtr<FJsonObject> Caps = ParseAgentJson(Api->GetCapabilitiesJson());
+	const FString Epoch = Caps.IsValid() ? Caps->GetStringField(TEXT("world_epoch")) : FString();
+	TestFalse(TEXT("capabilities carry a world_epoch"), Epoch.IsEmpty());
+	TestTrue(TEXT("capabilities list commands with tiers"), Caps.IsValid() && Caps->GetArrayField(TEXT("commands")).Num() > 0);
+
+	const FString Fresh = Api->GetSnapshotJson(false);
+	const uint64 Rev = Api->CurrentRevision();
+	const TSharedPtr<FJsonObject> Peek = ParseAgentJson(Api->PeekSnapshotJson());
+	TestTrue(TEXT("peek returns the snapshot with the epoch"), Peek.IsValid() && Peek->GetStringField(TEXT("world_epoch")) == Epoch);
+	Api->PeekSnapshotJson();
+	TestEqual(TEXT("peeking does not revise the world"), Api->CurrentRevision(), Rev);
+
+	const TSharedPtr<FJsonObject> Events = ParseAgentJson(Api->GetEventsSince(TEXT("")));
+	TestTrue(TEXT("events from the start: no gap"), Events.IsValid() && !Events->GetBoolField(TEXT("gap")));
+	TestTrue(TEXT("events carry the contract fields"), Events.IsValid() && Events->GetArrayField(TEXT("events")).Num() > 0
+		&& Events->GetArrayField(TEXT("events"))[0]->AsObject()->HasField(TEXT("kind"))
+		&& Events->GetArrayField(TEXT("events"))[0]->AsObject()->HasField(TEXT("t")));
+	const TSharedPtr<FJsonObject> Old = ParseAgentJson(Api->GetEventsSince(TEXT("another-world:3")));
+	TestTrue(TEXT("another world's cursor is a gap"), Old.IsValid() && Old->GetBoolField(TEXT("gap"))
+		&& Old->GetStringField(TEXT("reason")) == TEXT("world_changed"));
+	const TSharedPtr<FJsonObject> Bad = ParseAgentJson(Api->GetEventsSince(TEXT("garbage")));
+	TestTrue(TEXT("a malformed cursor is reported"), Bad.IsValid() && Bad->GetStringField(TEXT("reason")) == TEXT("bad_cursor"));
+
+	const int64 CycleBefore = Fix.Manager->CycleCounter;
+	const TSharedPtr<FJsonObject> Expired = ParseAgentJson(Api->ExecuteCommandJson(
+		TEXT("{\"request_id\":\"e1\",\"world_epoch\":\"another-world\",\"command\":\"step_cycles\",\"cycles\":2}")));
+	TestTrue(TEXT("another world's command is refused"), Expired.IsValid() && !Expired->GetBoolField(TEXT("accepted"))
+		&& Expired->GetStringField(TEXT("error_code")) == TEXT("dedup_expired"));
+	TestEqual(TEXT("a refused command does not run"), Fix.Manager->CycleCounter, CycleBefore);
+	const FString Req = FString::Printf(TEXT("{\"request_id\":\"e2\",\"world_epoch\":\"%s\",\"command\":\"step_cycles\",\"cycles\":2}"), *Epoch);
+	const TSharedPtr<FJsonObject> Ok = ParseAgentJson(Api->ExecuteCommandJson(Req));
+	TestTrue(TEXT("this world's command runs and echoes request_id"), Ok.IsValid() && Ok->GetBoolField(TEXT("accepted"))
+		&& Ok->GetStringField(TEXT("request_id")) == TEXT("e2"));
+	TestEqual(TEXT("it advanced two cycles"), Fix.Manager->CycleCounter, CycleBefore + 2);
+	return true;
+}
