+FString UPolyWorldAgentSubsystem::GetEventsSince(const FString& Cursor) const
+{
+	TSharedRef<FJsonObject> Root = MakeShared<FJsonObject>();
+	Root->SetStringField(TEXT("world_epoch"), WorldEpoch);
+	uint64 After = 0;
+	bool bGap = false;
+	uint64 Dropped = 0;
+	FString Epoch, Rev;
+	if (!Cursor.IsEmpty())
+	{
+		if (!Cursor.Split(TEXT(":"), &Epoch, &Rev) || !Rev.IsNumeric())
+		{
+			bGap = true; // not a cursor this API made: replay from the start, flagged
+			Root->SetStringField(TEXT("reason"), TEXT("bad_cursor"));
+		}
+		else if (Epoch != WorldEpoch)
+		{
+			bGap = true; // another world's cursor: everything since this world began
+			Root->SetStringField(TEXT("reason"), TEXT("world_changed"));
+		}
+		else
+		{
+			After = FCString::Strtoui64(*Rev, nullptr, 10);
+		}
+	}
+	const uint64 Oldest = EventJournal.Num() > 0 ? EventJournal[0].EventRevision : Revision + 1;
+	if (After + 1 < Oldest)
+	{
+		Dropped = Oldest - (After + 1); // lost to the 512-event journal (also for another world's cursor)
+		if (!bGap)
+		{
+			bGap = true;
+			Root->SetStringField(TEXT("reason"), TEXT("journal_overrun"));
+		}
+	}
+	TArray<TSharedPtr<FJsonValue>> Events;
+	uint64 Last = After;
+	for (const FAgentEvent& Event : EventJournal)
+	{
+		if (Event.EventRevision <= After) { continue; }
+		TSharedRef<FJsonObject> Json = MakeShared<FJsonObject>();
+		Json->SetNumberField(TEXT("seq"), (double)Event.EventRevision);
+		Json->SetNumberField(TEXT("t"), Event.T);
+		Json->SetStringField(TEXT("kind"), Event.Type);
+		Json->SetStringField(TEXT("actor"), Event.EntityId);
+		Json->SetBoolField(TEXT("by_player"), false);
+		TSharedPtr<FJsonObject> Data;
+		if (FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Event.PayloadJson), Data) && Data.IsValid())
+		{
+			Json->SetObjectField(TEXT("data"), Data);
+		}
+		Json->SetNumberField(TEXT("cycle"), (double)Event.Cycle);
+		Events.Add(MakeShared<FJsonValueObject>(Json));
+		Last = Event.EventRevision;
+	}
+	Root->SetArrayField(TEXT("events"), Events);
+	Root->SetBoolField(TEXT("gap"), bGap);
+	Root->SetNumberField(TEXT("dropped"), (double)Dropped);
+	Root->SetStringField(TEXT("next_cursor"), FString::Printf(TEXT("%s:%llu"), *WorldEpoch, Last));
 	return JsonString(Root);
 }
 
